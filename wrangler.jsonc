{
  // Revl AI: static site in ./revl-ai plus a small Worker (src/worker.js) that
  // forces HTTPS, adds security headers and stores waitlist signups in D1.
  // Deploy with: npx wrangler deploy
  "name": "revl-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./revl-ai",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the Worker first so plain HTTP can be
    // redirected and headers added. Static pages are then read from ASSETS.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revl-ai-waitlist",
      "database_id": "ffaf669e-c57f-4d59-88bd-ad3ebef8513e"
    }
  ],
  // At most 5 signup attempts per minute from one IP address.
  "ratelimits": [
    {
      "name": "WAITLIST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "proxyrevlvay.com", "custom_domain": true },
    // The Worker redirects www to the bare domain.
    { "pattern": "www.proxyrevlvay.com", "custom_domain": true }
  ]
}
